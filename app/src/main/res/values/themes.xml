<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/term_background</item>
        <item name="android:colorBackground">@color/term_background</item>
        <item name="colorPrimary">@color/term_green</item>
        <item name="colorPrimaryVariant">@color/term_surface</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">@color/term_green</item>
        <item name="colorSurface">@color/term_surface</item>
        <item name="colorOnSurface">@color/term_text_primary</item>
        <item name="android:statusBarColor">@color/term_background</item>
        <item name="android:navigationBarColor">@color/term_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>

    <style name="TerminalDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog_terminal</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>
</resources>
